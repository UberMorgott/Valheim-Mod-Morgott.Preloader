<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- xUnit v3 on Microsoft Testing Platform (build\Valheim.Build.props tests layer). IsTestProject here:
         the props are evaluated before this body, and quality-gate runs dotnet test only for test projects. -->
    <ValheimTests>true</ValheimTests>
    <IsTestProject>true</IsTestProject>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>Morgott.Preloader.Tests</AssemblyName>
    <RootNamespace>Morgott.Preloader.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The real Unity-free sources, not copies. -->
    <Compile Include="..\BundleCache\LzmaDecoder.cs" Link="src\LzmaDecoder.cs" />
    <Compile Include="..\BundleCache\BundleHeader.cs" Link="src\BundleHeader.cs" />
    <None Include="Data\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
